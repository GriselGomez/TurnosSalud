<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Marca -->
    <Color x:Key="Primary">#0B5ED7</Color>
    <Color x:Key="PrimaryDark">#0842A0</Color>
    <Color x:Key="PrimaryLight">#EAF2FF</Color>
    <Color x:Key="PrimarySoft">#C7DCFF</Color>
    <Color x:Key="PrimaryDisabled">#9DBDF0</Color>
    <Color x:Key="OnPrimarySoft">#DCE8FF</Color>

    <!-- Superficies -->
    <Color x:Key="Background">#F5F8FC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceMuted">#F1F5F9</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>

    <!-- Texto (contraste AA sobre blanco) -->
    <Color x:Key="TextPrimary">#1B2433</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextMuted">#94A3B8</Color>

    <!-- Estados -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessLight">#E8F7EE</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerLight">#FEF2F2</Color>
    <Color x:Key="Warning">#B45309</Color>
    <Color x:Key="WarningLight">#FFF7E6</Color>
    <Color x:Key="Star">#F5B301</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#0B5ED7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />

</ResourceDictionary>
